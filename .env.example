# Supabase project URL and publishable key (used by the public client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key; server-side only, never expose or commit a real value
SUPABASE_SECRET_KEY=

# Shared admin PIN for write operations; choose a private value
ADMIN_PIN=
